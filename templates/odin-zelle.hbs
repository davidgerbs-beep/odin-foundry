{{#if (eq typ "text")}}<input type="text" name="{{name}}" value="{{wert}}">{{else if (eq typ "check")}}<input type="checkbox" name="{{name}}" {{checked wert}}>{{else if (eq typ "select")}}<select name="{{name}}">{{selectOptions optionen selected=wert}}</select>{{else if (eq typ "kaestchen")}}<span class="kaestchen" data-pfad="{{pfad}}">{{#each liste}}<i class="{{this.cls}}" data-action="kasten" data-n="{{this.n}}"></i>{{/each}}</span>{{else}}{{wert}}{{/if}}