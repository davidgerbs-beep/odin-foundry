<section class="tab fertigkeiten {{tab.cssClass}}" data-group="primary" data-tab="fertigkeiten">
  <div class="fert-raster">
    {{#each gruppen}}
    <div class="block gruppe gruppe-{{id}}">
      <h3>{{label}}</h3>
      <div class="zeile kopfzeile"><span></span><span>{{localize "ODIN.Spalte.Punkte"}}</span><span>{{localize "ODIN.Spalte.Bonus"}}</span><span>{{localize "ODIN.Spalte.Wert"}}</span></div>
      {{#each fert}}
      <div class="zeile{{#if hauptgabe}} hauptgabe{{/if}}">
        <a class="wurf" data-action="probe" data-fert="{{key}}" data-tooltip="{{tip}}"><i class="fa-solid fa-dice-d6"></i> {{name}}{{#if grund}} <span class="grund">•</span>{{/if}} <small>{{attr}}</small></a>
        <input type="number" name="system.fertigkeiten.{{key}}.punkte" value="{{punkte}}" min="0" max="6">
        <span class="bonus">{{#if bonus}}+{{bonus}}{{/if}}</span>
        <span class="wert">{{wert}}</span>
      </div>
      {{/each}}
    </div>
    {{/each}}
  </div>
  {{#if extraFert.length}}
  <div class="block"><h3>{{localize "ODIN.Block.WeitereFert"}}</h3>
    {{#each extraFert as |i|}}<div class="itemzeile" data-item-id="{{i.id}}"><a data-action="itemBearbeiten">{{i.name}}</a><span>{{i.system.attr}} · {{i.system.wert}}</span><a data-action="itemLoeschen"><i class="fa-solid fa-trash"></i></a></div>{{/each}}
  </div>{{/if}}
  <p class="hinweis">{{localize "ODIN.Hinweis.Fertigkeiten"}}</p>
</section>
