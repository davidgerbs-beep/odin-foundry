<section class="tab signatur {{tab.cssClass}}" data-group="primary" data-tab="signatur">
  {{#if (or istPsion istThaumaturg)}}
  <div class="block">
    <h3>{{#if istPsion}}{{localize "ODIN.Block.Kraefte"}}{{else}}{{localize "ODIN.Block.Zauber"}}{{/if}}
      <a class="neu" data-action="itemNeu" data-type="{{#if istPsion}}kraft{{else}}zauber{{/if}}"><i class="fa-solid fa-plus"></i></a></h3>
    <div class="liste kraefte">
      {{#each kraefte}}
      <div class="itemzeile" data-item-id="{{k.id}}">
        <a class="wurf" data-action="wirken" data-tooltip="{{localize "ODIN.Tip.Wirken"}}"><i class="fa-solid fa-wand-sparkles"></i></a>
        <a data-action="itemBearbeiten">{{k.name}}</a><span>{{kat}}</span><span>{{kosten}} {{res}}</span><span>{{probe}}</span>
        <a data-action="itemLoeschen"><i class="fa-solid fa-trash"></i></a>
      </div>
      {{else}}<p class="hinweis">{{localize "ODIN.Hinweis.KeineKraefte"}}</p>{{/each}}
    </div>
    <p class="hinweis">{{localize "ODIN.Hinweis.Kraefte"}}</p>
  </div>
  {{/if}}
  <div class="block">
    <h3>{{#if system.signaturName}}{{system.signaturName}}{{else}}{{localize "ODIN.Block.Signatur"}}{{/if}} <a class="neu" data-action="itemNeu" data-type="signatur"><i class="fa-solid fa-plus"></i></a></h3>
    {{#each signaturen as |s|}}
    <div class="itemzeile sig" data-item-id="{{s.id}}"><a data-action="itemBearbeiten">{{s.name}}</a><span>{{s.system.art}}</span><span>{{s.system.nummer}}</span><span>{{s.system.zustand}}</span><a data-action="itemLoeschen"><i class="fa-solid fa-trash"></i></a></div>
    {{/each}}
    <prose-mirror name="system.signatur" button="true" editable="{{editable}}" toggled="true" value="{{source.signatur}}">{{{html.[system.signatur]}}}</prose-mirror>
  </div>
  <div class="block">
    <h3>{{localize "ODIN.Block.Klassenbaum"}} <a class="neu" data-action="itemNeu" data-type="knoten"><i class="fa-solid fa-plus"></i></a></h3>
    {{#each knoten as |k|}}
    <div class="itemzeile knoten" data-item-id="{{k.id}}"><a data-action="itemBearbeiten">{{k.name}}</a><span>{{k.system.baum}}</span><span>{{k.system.stufe}}</span><span>{{k.system.kosten}} EP</span><a data-action="itemLoeschen"><i class="fa-solid fa-trash"></i></a></div>
    {{/each}}
    <prose-mirror name="system.klassenbaum" button="true" editable="{{editable}}" toggled="true" value="{{source.klassenbaum}}">{{{html.[system.klassenbaum]}}}</prose-mirror>
  </div>
</section>
