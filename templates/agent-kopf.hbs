<header class="akte-kopf" style="--akzent: {{akzent}}">
  <div class="kopfbalken">
    <div class="kopf-links">
      <div class="emblem">{{{emblem}}}</div>
      <div>
        <div class="zweig">O.D.I.N. · {{zweig}}</div>
        <div class="klassenname">{{#if system.klasse}}{{klasseAnzeige}}{{else}}{{localize "ODIN.Kopf.OhneKlasse"}}{{/if}}</div>
        <div class="subklassenname">{{#if system.subklasse}}{{subAnzeige}}{{else}}{{localize "ODIN.Kopf.SubklasseLeer"}}{{/if}}</div>
      </div>
    </div>
    <div class="kopf-rechts">
      <div class="stempel-vertraulich">{{localize "ODIN.Kopf.Personalakte"}} · {{localize "ODIN.Kopf.VertraulichKurz"}}</div>
      <div class="kopf-knoepfe"><a class="bearbeiten-knopf" data-action="import" data-tooltip="{{localize "ODIN.Knopf.Import"}}"><i class="fa-solid fa-file-import"></i> {{localize "ODIN.Knopf.ImportKurz"}}</a>
      <a class="bearbeiten-knopf{{#if bearbeiten}} aktiv{{/if}}" data-action="bearbeiten" data-tooltip="{{localize "ODIN.Tip.Bearbeiten"}}"><i class="fa-solid fa-pen-to-square"></i> {{localize "ODIN.Knopf.Bearbeiten"}}</a></div>
    </div>
  </div>
  <div class="kopf-oben">
    <div class="kopf-felder">
      <label class="feld gross"><input type="text" name="name" value="{{actor.name}}"><span>{{localize "ODIN.Kopf.Codename"}}</span></label>
      <label class="feld"><input type="text" name="system.klarname" value="{{system.klarname}}"><span>{{localize "ODIN.Kopf.Name"}}</span></label>
      <label class="feld"><input type="text" name="system.alter" value="{{system.alter}}"><span>{{localize "ODIN.Kopf.Alter"}}</span></label>
      <label class="feld"><input type="text" name="system.herkunft" value="{{system.herkunft}}"><span>{{localize "ODIN.Kopf.Herkunft"}}</span></label>
      <label class="feld"><select name="system.rang">{{selectOptions raenge selected=system.rang}}</select><span>{{localize "ODIN.Kopf.Rang"}}</span></label>
      <label class="feld"><input type="text" name="system.antrieb" value="{{system.antrieb}}"><span>{{localize "ODIN.Kopf.Antrieb"}}</span></label>
      <label class="feld"><select name="system.klasse">{{selectOptions klassen selected=system.klasse}}</select><span>{{localize "ODIN.Kopf.Klasse"}}</span></label>
      <label class="feld"><select name="system.subklasse">{{selectOptions subklassen selected=system.subklasse}}</select><span>{{localize "ODIN.Kopf.Subklasse"}}</span></label>
    </div>
    <div class="foto"><img src="{{actor.img}}" data-edit="img" data-action="editImage" alt="{{actor.name}}"><i class="klammer"></i></div>
  </div>
</header>
