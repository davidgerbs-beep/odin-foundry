<section class="tab notizen {{tab.cssClass}}" data-group="primary" data-tab="notizen">
  <div class="zwei-spalten">
    <div class="block">
      <h3>{{localize "ODIN.Notiz.Hintergrund"}}</h3>
      <prose-mirror name="system.hintergrund" button="true" editable="{{editable}}" toggled="true" value="{{source.hintergrund}}">{{{html.[system.hintergrund]}}}</prose-mirror>
      <h3>{{localize "ODIN.Notiz.Rekrutierung"}}</h3>
      <prose-mirror name="system.rekrutierung" button="true" editable="{{editable}}" toggled="true" value="{{source.rekrutierung}}">{{{html.[system.rekrutierung]}}}</prose-mirror>
      <h3>{{localize "ODIN.Notiz.ErsterFall"}}</h3>
      <prose-mirror name="system.ersterFall" button="true" editable="{{editable}}" toggled="true" value="{{source.ersterFall}}">{{{html.[system.ersterFall]}}}</prose-mirror>
      <h3>{{localize "ODIN.Notiz.Detail"}}</h3>
      <prose-mirror name="system.detail" button="true" editable="{{editable}}" toggled="true" value="{{source.detail}}">{{{html.[system.detail]}}}</prose-mirror>
      <h3>{{localize "ODIN.Notiz.Anker"}}</h3>
      <prose-mirror name="system.anker" button="true" editable="{{editable}}" toggled="true" value="{{source.anker}}">{{{html.[system.anker]}}}</prose-mirror>
    </div>
    <div class="block">
      <h3>{{localize "ODIN.Block.Traumata"}} <a class="neu" data-action="itemNeu" data-type="trauma"><i class="fa-solid fa-plus"></i></a></h3>
      {{#each traumata as |t|}}<div class="itemzeile einfach" data-item-id="{{t.id}}"><a data-action="itemBearbeiten">{{t.name}}</a><a data-action="itemLoeschen"><i class="fa-solid fa-trash"></i></a></div>{{/each}}
      <h3>{{localize "ODIN.Block.Kontakte"}} <a class="neu" data-action="itemNeu" data-type="kontakt"><i class="fa-solid fa-plus"></i></a></h3>
      {{#each kontakte as |k|}}<div class="itemzeile einfach" data-item-id="{{k.id}}"><a data-action="itemBearbeiten">{{k.name}}</a><a data-action="itemLoeschen"><i class="fa-solid fa-trash"></i></a></div>{{/each}}
      <h3>{{localize "ODIN.Notiz.Notizen"}}</h3>
      <prose-mirror name="system.notizen" button="true" editable="{{editable}}" toggled="true" value="{{source.notizen}}">{{{html.[system.notizen]}}}</prose-mirror>
      <h3>{{localize "ODIN.Block.Laufbahn"}}</h3>
      <div class="raster raster-2">
        <label>{{localize "ODIN.Werte.EP"}}<input type="number" name="system.ep" value="{{system.ep}}"></label>
        <label>{{localize "ODIN.Werte.EPFrei"}}<input type="number" name="system.epFrei" value="{{system.epFrei}}"></label>
      </div>
    </div>
  </div>
</section>
