{
  "id": "odin-rpg",
  "title": "O.D.I.N. – Occult Dynamics Intelligence Network",
  "description": "Spielsystem für O.D.I.N., das Pen-&-Paper-Rollenspiel um okkulte Agenten (Zweite Edition). Zwei Würfelfarben: weiß ab 5, bunt ab 4. Bögen für Agenten und Gegner, Proben, Kampf, Grauen, Psi-Kräfte und Zauber, Preis der Klasse, Import aus dem Charaktergenerator. Regelwerk kostenlos auf odin-rpg.pages.dev.",
  "version": "0.1.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14.368"
  },
  "authors": [
    {
      "name": "David Ger",
      "url": "https://odin-rpg.pages.dev"
    }
  ],
  "esmodules": [
    "odin.mjs"
  ],
  "styles": [
    "styles/odin.css"
  ],
  "languages": [
